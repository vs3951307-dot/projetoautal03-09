# Configuração para RODAR OS TESTES contra um PostgreSQL de teste real.
#
# Copie para `.env.test` (ou exporte as variáveis) antes de `npm run test:all`.
# As suítes de banco se RECUSAM a rodar contra um banco que não esteja
# claramente marcado como de teste (nome contendo "test", host local, ou
# PEDIDOFLOW_TEST_DB=1) — elas criam e apagam dados.
#
# Preparação (uma vez):
#   createdb pedidoflow_test
#   npx prisma migrate deploy
#   npx prisma db seed        # cria os 2 tenants que as suítes usam
#
# NUNCA aponte para o banco de produção.

DATABASE_URL="postgresql://postgres@127.0.0.1:5433/pedidoflow_test?schema=public"
DIRECT_URL="postgresql://postgres@127.0.0.1:5433/pedidoflow_test?schema=public"
