{
  "name": "pedidoflow-saas",
  "version": "1.0.0",
  "private": true,
  "description": "PedidoFlow — plataforma SaaS multiempresa (PDV, mesas, delivery, WhatsApp/IA, fiscal, impressão). React + Next.js + TypeScript + Tailwind CSS + shadcn/ui + Prisma/PostgreSQL.",
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=2048 prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "deploy:migrar": "node scripts/resolve-failed-migrations.cjs && prisma migrate deploy && tsx scripts/sincronizar-schemas-tenants.ts && tsx scripts/backfill-etapa1.ts && tsx scripts/setup-config-pizza.ts",
    "db:seed": "node scripts/guarda-destrutiva.cjs \"prisma db seed\"",
    "db:reset": "node scripts/guarda-destrutiva.cjs \"prisma migrate reset --force\"",
    "db:migrar-postgres": "tsx scripts/migrar-sqlite-para-postgres.ts",
    "db:provisionar-tenant": "tsx scripts/provisionar-schema-empresa.ts",
    "db:sync-tenants": "tsx scripts/sincronizar-schemas-tenants.ts",
    "db:backfill-etapa1": "tsx scripts/backfill-etapa1.ts",
    "db:conferir-precos": "tsx scripts/conferir-precos.ts",
    "db:conferir-taxas": "tsx scripts/conferir-taxas.ts",
    "db:criar-super-admin": "tsx scripts/criar-super-admin.ts",
    "db:resetar-senha-super-admin": "tsx scripts/resetar-senha-super-admin.ts",
    "test": "vitest run",
    "test:dom": "vitest run -c vitest.dom.config.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:dom"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.28.0",
    "next": "^14.2.35",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "happy-dom": "20.11.2",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^14.2.33"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "tesseract.js@5.1.1": true,
    "unrs-resolver@1.12.2": true
  }
}
